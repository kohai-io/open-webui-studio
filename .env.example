ORIGIN=http://localhost:5173
OWUI_BASE_URL=http://localhost:8080
OIDC_ISSUER_URL=https://identity.example.invalid
OIDC_CLIENT_ID=open-webui-studio
OIDC_SCOPES=openid profile email
# Supply secrets through the deployment secret manager; never commit them.
OIDC_CLIENT_SECRET=
SESSION_SECRET=
SESSION_ENCRYPTION_KEY=
STUDIO_DATABASE_PATH=./data/studio.db
OWUI_OAUTH_PROVIDER=oidc
FLOW_WORKER_ENABLED=true
FLOW_WORKER_ID=studio-local
FLOW_WORKER_POLL_MS=1000
FLOW_CLAIM_TTL_MS=30000
FLOW_HEARTBEAT_INTERVAL_MS=10000
FLOW_RUN_TIMEOUT_MS=600000
FLOW_NODE_TIMEOUT_MS=120000
FLOW_MAX_CONCURRENT=4
